# =============================================================================
#  Pandal Office Management - server settings
#
#  Read by systemd (see pandal.service). Every line is NAME=value, no quotes,
#  no spaces around the "=". After changing anything here:
#
#      sudo systemctl restart pandal
#
#  Keep this file private - it holds the database password and the signing key:
#      sudo chown root:root /opt/pandal/pandal.env
#      sudo chmod 600 /opt/pandal/pandal.env
# =============================================================================

# ---- database ---------------------------------------------------------------
# The database itself is created on first start if it does not exist, but the
# MySQL user below must already exist and have rights on it. See README step 3.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=office_management
DB_USER=pandal
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# ---- signing key for login tokens -------------------------------------------
# REPLACE THIS. Anyone holding this string can mint a valid login token for any
# account. Generate one on the server with:
#
#     openssl rand -base64 48
#
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_base64_48
# How long a login lasts, in minutes. 480 = 8 hours.
JWT_EXPIRATION_MINUTES=480

# ---- the first administrator -------------------------------------------------
# Created only if no admin exists yet. Set a real password here BEFORE the first
# start; if you leave the default, change it in the app immediately after.
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ---- web --------------------------------------------------------------------
# The app listens here on the machine itself. nginx is what faces the internet
# and forwards to this port, so it does not need to be open in the firewall.
SERVER_PORT=8080

# The browser talks to https://pandaldepartment.tech and nginx forwards /api to
# this app, so requests are same-origin and CORS is not normally involved. These
# are listed anyway, for anything that reaches the port directly.
CORS_ORIGINS=https://pandaldepartment.tech,https://www.pandaldepartment.tech,http://pandaldepartment.tech,http://www.pandaldepartment.tech

# ---- schema ------------------------------------------------------------------
# validate: the app checks the tables match its entities and refuses to start if
# they have drifted. Leave it alone - the tables are created and upgraded by
# db/schema.sql inside the jar on every start.
DDL_AUTO=validate

# ---- email (optional) --------------------------------------------------------
# Only needed if you want to share reports by email. Leave blank to keep it off;
# the app records the share and tells you the channel is off.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
